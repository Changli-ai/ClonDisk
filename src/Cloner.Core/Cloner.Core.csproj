<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- E/S cruda con búferes alineados y P/Invoke generado por CsWin32. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369" PrivateAssets="all" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cloner.Core.Tests" />
    <InternalsVisibleTo Include="Cloner.IntegrationTests" />
  </ItemGroup>

</Project>
