<controls:RoundedWindow x:Class="Cloner.App.DiskPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloner.App.Controls"
        Title="Elegir un disco · ClonDisk"
        Icon="Assets/ClonDisk.ico"
        Width="600" Height="500" MinWidth="470" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <controls:RoundedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:NotVisibleConverter x:Key="NotVisible" />
    </controls:RoundedWindow.Resources>
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="Choices" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnChoiceDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}" />
                                <!-- Candado: el disco lo necesita este equipo (Windows en uso, su arranque o la app) -->
                                <Border Background="{StaticResource Accent}" CornerRadius="8" Width="16" Height="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding LockLabel}" FontSize="11" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DisabledReason}" Foreground="{StaticResource DangerText}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding IsSelectable, Converter={StaticResource NotVisible}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Elegir" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnChooseClick" />
        </StackPanel>
    </Grid>
</controls:RoundedWindow>
