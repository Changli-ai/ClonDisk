<Window x:Class="Cloner.App.DiskPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir un disco · ClonDisk"
        Icon="Assets/ClonDisk.ico"
        Width="560" Height="460" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="Choices" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnChoiceDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Elegir" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnChooseClick" />
        </StackPanel>
    </Grid>
</Window>
