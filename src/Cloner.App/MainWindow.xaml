<Window x:Class="Cloner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloner.App.Controls"
        xmlns:vm="clr-namespace:Cloner.App.ViewModels"
        Title="ClonDisk"
        Icon="Assets/ClonDisk.ico"
        Width="1280" Height="800" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <!-- Barra de título propia: la de Windows 10 es blanca y no sigue el diseño. Se arrastra por la franja
         superior y conserva el ajuste a los bordes de la pantalla y el doble clic para maximizar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Botones de minimizar, maximizar y cerrar. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E3E8F0" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:NotVisibleConverter x:Key="NotVisible" />

        <!-- Oculta un elemento cuando su DataContext es nulo. -->
        <Style x:Key="HiddenWithoutData" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid Margin="0,5,16,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <Style x:Key="DiskListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="12"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <controls:SectionVisibilityConverter x:Key="SectionVisibility" />

        <!-- Barra lateral: degradado azul propio de ClonDisk. -->
        <LinearGradientBrush x:Key="SidebarBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C5BD6" Offset="0" />
            <GradientStop Color="#3B86F2" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SourceTile" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4C9BFF" Offset="0" />
            <GradientStop Color="#1F6FEB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TargetTile" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3DD68C" Offset="0" />
            <GradientStop Color="#16A365" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DashedStroke" Color="#C7D4E8" />
        <SolidColorBrush x:Key="EmptyCardFill" Color="#F6F9FD" />

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- La selección ya marca el foco; el rectángulo punteado abarcaría también el título del grupo. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <!-- Título del grupo («CLONAR», «HERRAMIENTAS»…), fuera del sombreado del elemento. -->
                            <TextBlock Text="{Binding GroupTitle}" Foreground="#B8FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       Margin="12,14,0,8" IsHitTestVisible="False"
                                       Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}" />
                            <Border x:Name="Root" Background="Transparent" CornerRadius="12" Margin="0,1">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#1C5BD6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cuadro grande con «+» de una tarjeta vacía. -->
        <Style x:Key="PlusTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="24" Background="{TemplateBinding Background}" Effect="{TemplateBinding Tag}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disco sugerido dentro de una tarjeta vacía. -->
        <Style x:Key="SuggestionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Background="{StaticResource SoftFill}" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9EEF6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.62" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón con aspecto de enlace. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de candado («Windows en uso»…). -->
        <DataTemplate x:Key="LockChip">
            <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Tarjeta grande de origen o destino: todo su contenido es un botón. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Width="30" Height="30" CornerRadius="15" Background="Transparent">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aviso de función que todavía no está disponible. -->
        <Style x:Key="ComingSoon" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- Tarjeta vacía con borde discontinuo y botón «+». Tag = color del botón. -->
        <DataTemplate x:Key="EmptyCard">
            <Grid Width="320" Height="230">
                <Rectangle RadiusX="18" RadiusY="18" Fill="{StaticResource EmptyCardFill}"
                           Stroke="{StaticResource DashedStroke}" StrokeThickness="2" StrokeDashArray="4 3" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{Binding Tile}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Prompt}" Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Flecha entre origen y destino: círculo con degradado de azul a verde. -->
        <DataTemplate x:Key="FlowArrow">
            <Grid Width="56" Height="56" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource WindowBackground}" Margin="-8" />
                <Ellipse Effect="{StaticResource AccentShadow}">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1F6FEB" Offset="0" />
                            <GradientStop Color="#16A365" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Punto y nombre del papel de la tarjeta: azul para el origen, verde para el destino. -->
        <DataTemplate x:Key="RoleHeader">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="Text" Text="{Binding}" Style="{StaticResource RoleLabel}" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="DESTINO">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessStrong}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource SuccessStrong}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tarjeta con un disco o sistema elegido: etiquetas, cifras, mapa de particiones y leyenda. -->
        <DataTemplate x:Key="FilledCard" DataType="{x:Type vm:CardContent}">
            <Border Style="{StaticResource Card}" Padding="24,22">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding Role}" ContentTemplate="{StaticResource RoleHeader}"
                                    Focusable="False" IsTabStop="False" />

                    <Grid DockPanel.Dock="Top" Margin="0,18,40,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Tile" Width="76" Height="76" CornerRadius="22" VerticalAlignment="Top" Margin="0,0,18,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF4FF" Offset="0" />
                                    <GradientStop Color="#DBE8FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SoftFill}" CornerRadius="10" Padding="9,2" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ContentControl Content="{Binding LockLabel}" ContentTemplate="{StaticResource LockChip}" Focusable="False" IsTabStop="False"
                                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Stats}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SoftFill}" CornerRadius="12" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel DockPanel.Dock="Bottom">
                        <ItemsControl ItemsSource="{Binding Segments}" Height="40">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ProportionalPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="controls:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Fill}" CornerRadius="8" Margin="1.5,0" Padding="8,0" ToolTip="{Binding ToolTip}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" Foreground="{Binding Foreground}" FontSize="10.5"
                                                       Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Footer}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Legend}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                    <Setter TargetName="Tile" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EAFBF2" Offset="0" />
                                <GradientStop Color="#D2F2E1" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessStrong}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EmptySourceCard">
            <Grid>
                <Rectangle RadiusX="20" RadiusY="20" Fill="#FAFCFF" Stroke="#B9D2FA" StrokeThickness="2" StrokeDashArray="4 3" />
                <DockPanel Margin="24,22">
                    <ContentControl DockPanel.Dock="Top" Content="ORIGEN" ContentTemplate="{StaticResource RoleHeader}"
                                    Focusable="False" IsTabStop="False" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <Button Style="{StaticResource PlusTile}" Background="{StaticResource AccentGradient}" Tag="{StaticResource AccentShadow}"
                                Command="{Binding PickSourceCommand}" ToolTip="Ver todos los discos" />
                        <TextBlock Text="Elige el disco de origen" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="El disco que se va a copiar. Solo se lee: nunca se modifica." Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,16" />
                        <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SourceSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SuggestionButton}" IsEnabled="{Binding IsSelectable}"
                                                ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.ChooseSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Elegir" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Foreground="{StaticResource Accent}"
                                                           Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Visibility="{Binding IsSelectable, Converter={StaticResource NotVisible}}">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding LockLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="Ver todos los discos…" Style="{StaticResource LinkButton}" Command="{Binding PickSourceCommand}"
                                HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmptyTargetCard">
            <Grid>
                <Rectangle RadiusX="20" RadiusY="20" Fill="#FAFEFC" Stroke="#A9DFC2" StrokeThickness="2" StrokeDashArray="4 3" />
                <DockPanel Margin="24,22">
                    <ContentControl DockPanel.Dock="Top" Content="DESTINO" ContentTemplate="{StaticResource RoleHeader}"
                                    Focusable="False" IsTabStop="False" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <Button Style="{StaticResource PlusTile}" Background="{StaticResource SuccessGradient}" Tag="{StaticResource SuccessShadow}"
                                Command="{Binding PickTargetCommand}" ToolTip="Ver todos los discos" />
                        <TextBlock Text="Elige el disco de destino" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="Recibirá la copia. Todo su contenido actual se borrará antes de copiar." Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,16" />
                        <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TargetSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SuggestionButton}" IsEnabled="{Binding IsSelectable}"
                                                ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.ChooseTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessStrong}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Elegir" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Foreground="{StaticResource SuccessStrong}"
                                                           Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Visibility="{Binding IsSelectable, Converter={StaticResource NotVisible}}">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding LockLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="Ver todos los discos…" Style="{StaticResource LinkButton}" Command="{Binding PickTargetCommand}"
                                HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- Pantalla de copia: cabecera con los pasos, tarjetas de origen y destino, aviso del candado y acciones. -->
        <DataTemplate DataType="{x:Type vm:CopyPanelViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <controls:StepIndicator Current="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,0,0,2" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0" MaxHeight="560" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Origen -->
                    <Grid>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmptySourceCard}" Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasSource, Converter={StaticResource NotVisible}}" />
                        <ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource FilledCard}" Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource ClearButton}" Command="{Binding ClearSourceCommand}" ToolTip="Quitar"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                                Visibility="{Binding CanClearSource, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <ContentPresenter Grid.Column="1" ContentTemplate="{StaticResource FlowArrow}" HorizontalAlignment="Center" />

                    <!-- Destino -->
                    <Grid Grid.Column="2">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmptyTargetCard}" Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasTarget, Converter={StaticResource NotVisible}}" />
                        <ContentControl Content="{Binding Target}" ContentTemplate="{StaticResource FilledCard}" Focusable="False" IsTabStop="False"
                                        Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource ClearButton}" Command="{Binding ClearTargetCommand}" ToolTip="Quitar"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>

                <!-- Aviso del candado -->
                <Border Grid.Row="2" Background="{StaticResource AccentSoft}" CornerRadius="14" Padding="14,10" Margin="0,18,0,0"
                        Visibility="{Binding HasLockedDisks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="10" Background="White" Margin="0,0,12,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Los discos con candado los necesita este equipo para funcionar: ClonDisk nunca los usará como destino."
                                   Foreground="#1D3F7A" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="El origen solo se lee: nunca se modifica." Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Actualizar discos" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="24,10" Command="{Binding NextCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Siguiente" />
                                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral flotante: la sombra va en una capa aparte para no difuminar el texto. -->
        <Grid Margin="16,16,0,16">
            <Border CornerRadius="18" Background="{StaticResource SidebarBackground}" Effect="{StaticResource AccentShadow}" />
            <Border CornerRadius="18">
                <Border.Background>
                    <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.35">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel Margin="14,20,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,10">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Image x:Name="SidebarLogo" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="ClonDisk" Foreground="White" FontSize="19" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock Text="Clonar discos en Windows" Foreground="#C8FFFFFF" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Pie: gratis y de código abierto, y la versión. -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="#1FFFFFFF" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Gratis y de código abierto" Foreground="White" FontWeight="Bold" />
                        <TextBlock Text="Sin anuncios, sin registro y sin telemetría." Foreground="#E6FFFFFF" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="SidebarVersion" Foreground="#B8FFFFFF" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBox" Width="32" Height="32" CornerRadius="10" Background="#24FFFFFF" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" CornerRadius="9" Background="#29FFFFFF" Padding="8,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource NotVisible}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="IconBox" Property="Background" Value="{StaticResource AccentSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.8" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Contenido de la sección elegida -->
        <Grid Grid.Column="1" Margin="34,46,30,22">

            <ContentControl Content="{Binding DiskCopy}"
                            Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=DiskCopy}" />

            <ContentControl Content="{Binding SystemCopy}"
                            Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=SystemCopy}" />

            <!-- Partición (etapa 6) -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=PartitionCopy}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Clonar una partición" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Copia una sola partición a espacio libre o a una partición de otro disco, por ejemplo una unidad externa."
                               Style="{StaticResource PageSubtitle}" />
                    <Border Style="{StaticResource ComingSoon}">
                        <TextBlock Text="Próximamente: el clonado de particiones llegará en una próxima versión." Foreground="{StaticResource Accent}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" Opacity="0.55">
                    <ContentControl Focusable="False" IsTabStop="False" ContentTemplate="{StaticResource EmptyCard}">
                        <ContentControl.Content>
                            <vm:EmptyCardContent Prompt="Elige la partición de origen" Tile="{StaticResource SourceTile}" />
                        </ContentControl.Content>
                    </ContentControl>
                    <ContentPresenter ContentTemplate="{StaticResource FlowArrow}" Margin="22,0" />
                    <ContentControl Focusable="False" IsTabStop="False" ContentTemplate="{StaticResource EmptyCard}">
                        <ContentControl.Content>
                            <vm:EmptyCardContent Prompt="Elige la partición de destino" Tile="{StaticResource TargetTile}" />
                        </ContentControl.Content>
                    </ContentControl>
                </StackPanel>
                <Button Grid.Row="2" Content="Siguiente" Style="{StaticResource PrimaryButton}" Padding="34,10" IsEnabled="False" HorizontalAlignment="Right" />
            </Grid>

            <!-- Migrar a Windows 11 (etapa 11) -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Windows11}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Migrar a Windows 11" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        Instala un <Run FontWeight="SemiBold" Text="Windows 11 nuevo" /> en otro disco y lleva a él tus archivos, programas y ajustes.
                        También en equipos que no cumplen los requisitos de hardware de Windows 11, avisando de lo que implica.
                    </TextBlock>
                    <Border Style="{StaticResource ComingSoon}">
                        <TextBlock Text="Próximamente: la migración a Windows 11 llegará en una próxima versión." Foreground="{StaticResource Accent}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75">
                    <Grid Width="120" Height="120">
                        <Border CornerRadius="16" Background="{StaticResource AccentSoft}" />
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="58" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ContentPresenter ContentTemplate="{StaticResource FlowArrow}" Margin="34,0" />
                    <Grid Width="120" Height="120">
                        <Border CornerRadius="16" Background="{StaticResource AccentSoft}" />
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="58" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource SuccessBackground}" CornerRadius="8" Padding="14,9" Margin="0,0,0,14">
                    <TextBlock Text="Consejo: el proceso suele durar entre 1 y 2 horas y el equipo se reiniciará solo durante la migración."
                               Foreground="{StaticResource SuccessText}" TextWrapping="Wrap" />
                </Border>
                <Button Grid.Row="3" Content="Siguiente" Style="{StaticResource PrimaryButton}" Padding="34,10" IsEnabled="False" HorizontalAlignment="Right" />
            </Grid>

            <!-- Disco de emergencia (etapa 8) -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=EmergencyDisk}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Disco de emergencia" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Crea un USB de arranque con ClonDisk para arrancar un equipo que no inicia y poner a salvo sus datos."
                               Style="{StaticResource PageSubtitle}" />
                    <Border Style="{StaticResource ComingSoon}">
                        <TextBlock Text="Próximamente: la creación del disco de emergencia llegará en una próxima versión." Foreground="{StaticResource Accent}" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,26,0,0" IsEnabled="False" Opacity="0.6" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton Content="USB" GroupName="Media" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="0,0,0,14" Padding="8,6" IsEditable="True" Text="No se encontró ninguna unidad USB." />
                    <RadioButton Grid.Row="1" Content="CD/DVD" GroupName="Media" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" Padding="8,6" IsEditable="True" Text="No se encontró ninguna grabadora." />
                    <RadioButton Grid.Row="2" Content="Crear una ISO" GroupName="Media" IsChecked="True" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Padding="8,6" Text="C:\Users\Usuario\Escritorio\ClonDisk-emergencia.iso" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Examinar…" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                </Grid>
                <Grid Grid.Row="2">
                    <Button Content="Añadir controlador" Style="{StaticResource SecondaryButton}" IsEnabled="False" HorizontalAlignment="Left" />
                    <Button Content="Crear" Style="{StaticResource PrimaryButton}" Padding="34,10" IsEnabled="False" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Clonación por red (etapa 12) -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=NetworkClone}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Clonación por red" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Otro equipo de tu red local puede recibir el sistema y los datos de este. Elige cómo arrancará el equipo que recibe la copia:"
                               Style="{StaticResource PageSubtitle}" />
                    <Border Style="{StaticResource ComingSoon}">
                        <TextBlock Text="Próximamente: la clonación por red llegará en una próxima versión." Foreground="{StaticResource Accent}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,22,0,0" IsEnabled="False" Opacity="0.6">
                    <Border CornerRadius="12" Background="{StaticResource AccentSoft}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="Network" IsChecked="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Accent}"
                                       Margin="10,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap">
                                El equipo de destino descarga y abre el receptor desde su <Run FontWeight="SemiBold" Text="navegador web" />.
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border CornerRadius="12" Background="{StaticResource EmptyCardFill}" Padding="18,16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="Network" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Accent}"
                                       Margin="10,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">
                                    El equipo de destino arranca el receptor por <Run FontWeight="SemiBold" Text="PXE" />, aunque no tenga sistema operativo.
                                </TextBlock>
                                <TextBlock Text="Guía para preparar el arranque PXE" Foreground="{StaticResource Accent}" TextDecorations="Underline"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Button Grid.Row="2" Content="Siguiente" Style="{StaticResource PrimaryButton}" Padding="34,10" IsEnabled="False" HorizontalAlignment="Right" />
            </Grid>

            <!-- Discos del equipo: inspección -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Disks}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Discos del equipo" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Elige un disco para ver sus particiones. Los discos con candado los necesita este equipo y no se pueden borrar."
                                   Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Actualizar" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="Clonar disco…" Command="{Binding CloneCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de discos -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                        <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                                 ItemContainerStyle="{StaticResource DiskListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,10">
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock Text="{Binding Heading}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Accent}"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{Binding LockReason}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding LockLabel}" FontSize="11" Foreground="White" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource WarningBackground}"
                                                    BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Aviso" FontSize="11" Foreground="{StaticResource WarningText}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Mensaje de carga, error o lista vacía -->
                    <TextBlock Grid.Column="2" DataContext="{Binding StatusMessage}" Text="{Binding}"
                               Style="{StaticResource HiddenWithoutData}"
                               Foreground="{StaticResource TextSecondary}" FontSize="15" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Detalle del disco seleccionado -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedDisk}" Style="{StaticResource HiddenWithoutData}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Model}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0">
                                        <Run Text="{Binding Heading, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Disco protegido: este equipo lo necesita y no se puede borrar ni usar como destino -->
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="Disco protegido:" /> <Run Text="{Binding LockLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <Run Text="{Binding LockReason, Mode=OneWay}" />
                                                    <Run Text="No se puede usar como destino de un clonado ni limpiar." />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource WarningBackground}"
                                                        BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                                                        CornerRadius="6" Padding="12,8" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Properties}" Margin="0,14,0,0"
                                                  ItemTemplate="{StaticResource PropertyRowTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Identity}"
                                                  ItemTemplate="{StaticResource PropertyRowTemplate}" />

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding CanRepairBoot, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Reparar el arranque…" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.RepairBootCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding DataContext.RepairStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Para un clon de Windows que no arranca (por ejemplo, con el error 0xc000000e) porque se puso en línea junto al original. Rehace su arranque sin borrar datos." />
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding CanPrepare, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Limpiar y formatear…" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.PrepareDiskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding DataContext.PrepareStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Borra todas las particiones del disco, también las de arranque y recuperación que deja un formateo, y crea una sola partición NTFS con letra. Úsalo con un disco que tuvo Windows antes de usarlo como disco de datos, para que el equipo no intente arrancar desde él." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Particiones" Style="{StaticResource SectionTitle}" />

                                    <!-- Mapa del disco -->
                                    <ItemsControl ItemsSource="{Binding Segments}" Height="52">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ProportionalPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="controls:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Fill}" CornerRadius="4" Margin="1,0"
                                                        Padding="7,0" ToolTip="{Binding ToolTip}">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SizeText}" Foreground="{Binding Foreground}"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <DataGrid ItemsSource="{Binding Partitions}" Margin="0,16,0,0"
                                              Visibility="{Binding HasPartitions, Converter={StaticResource BoolToVisibility}}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource CardBorder}"
                                              Background="Transparent" RowBackground="Transparent"
                                              BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow"
                                              IsHitTestVisible="False"
                                              ColumnHeaderStyle="{StaticResource GridHeader}"
                                              CellStyle="{StaticResource GridCell}"
                                              Foreground="{StaticResource TextPrimary}">
                                        <DataGrid.Columns>
                                            <!-- Anchos proporcionales y texto con ajuste de línea: la tabla siempre cabe. -->
                                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="Auto" />
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="1.5*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Volumen" Binding="{Binding Volume}" Width="1.2*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Formato" Binding="{Binding FileSystem}" Width="*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Size}" Width="1.1*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Usado" Binding="{Binding Used}" Width="1.1*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Cifrado" Binding="{Binding Encryption}" Width="1.3*" ElementStyle="{StaticResource GridText}" />
                                            <DataGridTextColumn Header="Marcas" Binding="{Binding Flags}" Width="1.5*" ElementStyle="{StaticResource GridText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Este disco no tiene particiones."
                                               Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPartitions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Minimizar, maximizar o restaurar y cerrar -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,8,0" Panel.ZIndex="10">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE923;" ToolTip="Restaurar" Click="OnMaximizeClick" />
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Cerrar" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
