<Window x:Class="Cloner.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClonDisk"
        Icon="Assets/ClonDisk.ico"
        Width="480" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Margen para que se vea la sombra alrededor de la tarjeta. -->
    <Border Margin="16" CornerRadius="14" Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#1B2330" />
        </Border.Effect>
        <Grid Margin="32,30,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image x:Name="Logo" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ClonDisk" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Clonado de discos y particiones" FontSize="14"
                               Foreground="{StaticResource TextSecondary}" Margin="1,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Iniciando…" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                             Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" />
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Row="3" FontSize="11" Margin="0,14,0,0"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
