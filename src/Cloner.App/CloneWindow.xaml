<Window x:Class="Cloner.App.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cloner.App.ViewModels"
        Title="Clonar un disco · ClonDisk"
        Icon="Assets/ClonDisk.ico"
        Width="820" Height="700" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="DiskChoiceTemplate">
            <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BulletTemplate">
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DetailRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Footer" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Clonar un disco" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Copia un disco completo a otro de igual o mayor capacidad, también el del sistema con Windows en marcha."
                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 1. Elegir discos -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <TextBlock Text="Comprobando los discos…" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCloseClick" Margin="0,0,10,0" />
                <Button Content="Revisar el clonado" Style="{StaticResource PrimaryButton}" Command="{Binding ReviewCommand}" IsDefault="True" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Disco de origen" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="El disco que se va a copiar. Solo se lee: no se modifica." Style="{StaticResource Hint}" />
                            <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Source}"
                                      ItemTemplate="{StaticResource DiskChoiceTemplate}" Padding="8,4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Disco de destino" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Recibe la copia. Todo su contenido actual se borrará." Style="{StaticResource Hint}" />
                            <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Target}"
                                      ItemTemplate="{StaticResource DiskChoiceTemplate}" Padding="8,4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Modo de copia" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <RadioButton IsChecked="{Binding UseSmartCopy}" GroupName="Mode" Content="Copia inteligente (recomendada)" FontWeight="SemiBold" />
                            <TextBlock Text="De los volúmenes NTFS solo copia los bloques en uso; es mucho más rápida. Las demás particiones se copian enteras."
                                       Style="{StaticResource Hint}" Margin="20,2,0,8" />
                            <RadioButton IsChecked="{Binding UseSectorCopy}" GroupName="Mode" Content="Sector a sector" FontWeight="SemiBold" />
                            <TextBlock Text="Copia todos los sectores, también el espacio libre. Más lenta; útil con sistemas de archivos que no reconoce."
                                       Style="{StaticResource Hint}" Margin="20,2,0,14" />
                            <CheckBox IsChecked="{Binding Verify}" Content="Verificar la copia al terminar (recomendado)" FontWeight="SemiBold" />
                            <TextBlock Text="Vuelve a leer el destino y lo compara con lo copiado. Tarda algo más, pero confirma que el clon es idéntico."
                                       Style="{StaticResource Hint}" Margin="20,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource DangerBackground}" BorderBrush="{StaticResource DangerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="No se puede clonar con esta selección" FontWeight="SemiBold" Foreground="{StaticResource DangerText}" />
                            <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource BulletTemplate}"
                                          Foreground="{StaticResource DangerText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- 2. Revisar y confirmar (RS-03) -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <Button Content="Atrás" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,10,0" />
                <Button Content="Borrar el destino y clonar" Style="{StaticResource DangerButton}" Command="{Binding StartCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ORIGEN · SOLO LECTURA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding SourceSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="DESTINO · SE BORRA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerText}" />
                                <TextBlock Text="{Binding TargetSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource DangerBackground}" BorderBrush="{StaticResource DangerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding EraseTitle}" FontWeight="SemiBold" Foreground="{StaticResource DangerText}" />
                            <ItemsControl ItemsSource="{Binding ErasedItems}" ItemTemplate="{StaticResource BulletTemplate}"
                                          Foreground="{StaticResource DangerText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <TextBlock Text="{Binding CopySummary}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{StaticResource WarningBackground}" BorderBrush="{StaticResource WarningBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Antes de continuar" FontWeight="SemiBold" Foreground="{StaticResource WarningText}" />
                            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource BulletTemplate}"
                                          Foreground="{StaticResource WarningText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding ConfirmErase}" Margin="2,16,0,0">
                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- 3. Progreso (RF-30, RF-31) -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            </StackPanel>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding RunTitle}" Foreground="{StaticResource TextSecondary}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding PhaseText}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PercentText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,12,0,0"
                                     Foreground="{StaticResource Accent}" Background="{StaticResource WindowBackground}" BorderThickness="0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Velocidad" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tiempo restante" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Procesado" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding BytesText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="En curso" Style="{StaticResource StatLabel}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding CurrentItem}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="No desconectes los discos ni apagues el equipo hasta que termine. Si cancelas, el destino quedará incompleto y sin tabla de particiones."
                           Style="{StaticResource Hint}" Margin="4,12,4,0" />
            </StackPanel>
        </DockPanel>

        <!-- 4. Resultado -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <Button Content="Exportar registro…" Style="{StaticResource SecondaryButton}" Command="{Binding ExportLogCommand}" Margin="0,0,10,0" />
                <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" Click="OnCloseClick" IsDefault="True" />
            </StackPanel>

            <StackPanel>
                <Border CornerRadius="8" BorderThickness="1" Padding="18,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:ResultTone.Success}">
                                    <Setter Property="Background" Value="{StaticResource SuccessBackground}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:ResultTone.Error}">
                                    <Setter Property="Background" Value="{StaticResource DangerBackground}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,12">
                    <ItemsControl ItemsSource="{Binding ResultDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
